<Project>
  <PropertyGroup>
    <Version>2.0.0</Version>
    <Authors>Umami contributors; Usagirei</Authors>
    <Company>Umami</Company>
    <Copyright>Copyright © Usagirei 2016-2017; Umami contributors 2026</Copyright>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RepositoryUrl>https://github.com/BakuretsuBaka/Umami-3DS-Theme-Editor</RepositoryUrl>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591;CS0618</NoWarn>
  </PropertyGroup>
</Project>
