<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>ThemeEditor.App</RootNamespace>
    <AssemblyName>UmamiThemeEditor</AssemblyName>
    
    <ApplicationIcon>Assets/umami.ico</ApplicationIcon>
    <ApplicationIcon>Assets/umami.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Description>Umami 3DS Theme Editor</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <PackageReference Include="Silk.NET.OpenAL" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ThemeEditor.Common\ThemeEditor.Common.csproj" />
  </ItemGroup>

  <!-- The resource library data pack (textures, sound effects, music) is downloaded by packaging/package.sh into library-pack/ and shipped next to the executable -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\library-pack\index.json')">
    <Content Include="..\..\library-pack\**\*" Link="Library\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ThemeEditor.Tests" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Resources\**\*.png;Resources\*.obj;Resources\*.bin" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

</Project>
